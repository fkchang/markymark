<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>markymark - <%= @current_file || 'Select a file' %></title>
  <script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
  <script>
    // Initialize mermaid with theme detection
    const isDark = localStorage.getItem('theme') === 'dark' ||
                   (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches);
    mermaid.initialize({ startOnLoad: true, theme: isDark ? 'dark' : 'default' });
  </script>
  <style>
    :root {
      /* Light theme colors */
      --bg-primary: #ffffff;
      --bg-secondary: #f6f8fa;
      --bg-tertiary: #f6f8fa;
      --border-color: #d0d7de;
      --text-primary: #24292f;
      --text-secondary: #57606a;
      --text-link: #0969da;
      --text-link-hover: #0860ca;
      --bg-active: #ddf4ff;
      --bg-hover: #eaeef2;
      --bg-code: #f6f8fa;
      --border-highlight: #0969da;
      --mermaid-bg: #ffffff;

      transition: background-color 0.3s ease, color 0.3s ease;
    }

    [data-theme="dark"] {
      /* Dark theme colors - GitHub dark dimmed palette */
      --bg-primary: #22272e;
      --bg-secondary: #2d333b;
      --bg-tertiary: #373e47;
      --border-color: #444c56;
      --text-primary: #adbac7;
      --text-secondary: #768390;
      --text-link: #539bf5;
      --text-link-hover: #6cb6ff;
      --bg-active: #1c2128;
      --bg-hover: #373e47;
      --bg-code: #2d333b;
      --border-highlight: #539bf5;
      --mermaid-bg: #2d333b;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica', 'Arial', sans-serif;
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
      background-color: var(--bg-primary);
      color: var(--text-primary);
      transition: background-color 0.3s ease, color 0.3s ease;
    }

    .app-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 16px;
      background-color: var(--bg-primary);
      border-bottom: 1px solid var(--border-color);
      flex-shrink: 0;
    }

    .app-branding {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .app-icon {
      width: 32px;
      height: 32px;
      border-radius: 4px;
    }

    .app-name {
      font-size: 18px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .main-container {
      display: flex;
      flex: 1;
      overflow: hidden;
    }

    .sidebar {
      width: 300px;
      background-color: var(--bg-secondary);
      border-right: 1px solid var(--border-color);
      overflow-y: auto;
      flex-shrink: 0;
    }

    .sidebar-header {
      padding: 16px;
      border-bottom: 1px solid var(--border-color);
      background-color: var(--bg-primary);
      font-weight: 600;
      font-size: 14px;
      color: var(--text-primary);
    }

    .header-actions {
      display: flex;
      gap: 4px;
      align-items: center;
    }

    .action-btn {
      background: none;
      border: none;
      cursor: pointer;
      font-size: 20px;
      padding: 4px 8px;
      border-radius: 6px;
      transition: background-color 0.2s;
    }

    .action-btn:hover:not(:disabled) {
      background-color: var(--bg-hover);
    }

    .action-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    .root-path {
      padding: 12px 16px;
      background-color: var(--bg-secondary);
      border-bottom: 1px solid var(--border-color);
      font-size: 12px;
      color: var(--text-secondary);
      font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
      overflow-x: auto;
      white-space: nowrap;
    }

    .root-path strong {
      color: var(--text-primary);
      font-weight: 600;
    }

    .change-dir {
      padding: 12px 16px;
      background-color: var(--bg-primary);
      border-bottom: 1px solid var(--border-color);
    }

    .change-dir form {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .change-dir input[type="text"] {
      width: 100%;
      padding: 6px 8px;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      font-size: 12px;
      font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
      overflow-x: auto;
      white-space: nowrap;
      background-color: var(--bg-primary);
      color: var(--text-primary);
    }

    .change-dir-buttons {
      display: flex;
      gap: 8px;
    }

    .change-dir button {
      flex: 1;
      padding: 6px 12px;
      background-color: var(--text-link);
      color: #ffffff;
      border: none;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
    }

    .change-dir button:hover {
      background-color: var(--text-link-hover);
    }

    .change-dir .browse-btn {
      background-color: var(--text-secondary);
    }

    .change-dir .browse-btn:hover {
      background-color: var(--text-secondary);
      opacity: 0.8;
    }

    .file-list {
      list-style: none;
    }

    .file-list li {
      border-bottom: 1px solid var(--border-color);
    }

    .file-list a {
      display: block;
      padding: 12px 16px;
      text-decoration: none;
      color: var(--text-link);
      font-size: 14px;
      transition: background-color 0.2s;
      word-break: break-word;
    }

    .file-list a:hover {
      background-color: var(--bg-hover);
    }

    .file-list a.active {
      background-color: var(--bg-active);
      font-weight: 600;
      border-left: 3px solid var(--border-highlight);
    }

    /* Accordion controls */
    .accordion-controls {
      display: flex;
      gap: 8px;
      margin-top: 8px;
    }

    .accordion-control-btn {
      padding: 4px 8px;
      font-size: 11px;
      background-color: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 4px;
      cursor: pointer;
      color: var(--text-primary);
      transition: background-color 0.2s;
    }

    .accordion-control-btn:hover {
      background-color: var(--bg-hover);
    }

    /* Directory accordion */
    .file-tree {
      margin-top: 12px;
    }

    .directory-section {
      margin-bottom: 4px;
    }

    .directory-header {
      display: flex;
      align-items: center;
      padding: 8px 12px;
      cursor: pointer;
      background-color: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 4px;
      transition: background-color 0.2s;
      user-select: none;
    }

    .directory-header:hover {
      background-color: var(--bg-hover);
    }

    .directory-arrow {
      display: inline-block;
      width: 16px;
      font-size: 12px;
      transition: transform 0.2s;
      color: var(--text-secondary);
    }

    .directory-name {
      flex: 1;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-primary);
      margin-left: 4px;
    }

    .file-count {
      font-size: 11px;
      color: var(--text-secondary);
      margin-left: 8px;
    }

    .directory-files {
      list-style: none;
      margin: 0;
      padding: 0;
      border-left: 2px solid var(--border-color);
      margin-left: 12px;
    }

    .directory-files li {
      border-bottom: 1px solid var(--border-color);
    }

    .directory-files li:last-child {
      border-bottom: none;
    }

    .directory-files a {
      display: block;
      padding: 8px 12px;
      text-decoration: none;
      color: var(--text-link);
      font-size: 13px;
      transition: background-color 0.2s;
      word-break: break-word;
    }

    .directory-files a:hover {
      background-color: var(--bg-hover);
    }

    .directory-files a.active {
      background-color: var(--bg-active);
      font-weight: 600;
      border-left: 3px solid var(--border-highlight);
    }

    .content {
      flex: 1;
      overflow-y: auto;
      padding: 32px;
      background-color: var(--bg-primary);
    }

    .markdown-body {
      max-width: 980px;
      margin: 0 auto;
    }

    /* Markdown styling */
    .markdown-body h1, .markdown-body h2, .markdown-body h3,
    .markdown-body h4, .markdown-body h5, .markdown-body h6 {
      margin-top: 24px;
      margin-bottom: 16px;
      font-weight: 600;
      line-height: 1.25;
    }

    .markdown-body h1 {
      font-size: 2em;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 0.3em;
    }

    .markdown-body h2 {
      font-size: 1.5em;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 0.3em;
    }

    .markdown-body h3 {
      font-size: 1.25em;
    }

    .markdown-body p {
      margin-bottom: 16px;
      line-height: 1.6;
    }

    .markdown-body ul, .markdown-body ol {
      margin-bottom: 16px;
      padding-left: 2em;
    }

    .markdown-body li {
      margin-top: 0.25em;
    }

    .markdown-body code {
      background-color: var(--bg-code);
      padding: 0.2em 0.4em;
      border-radius: 6px;
      font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace;
      font-size: 85%;
    }

    .markdown-body pre {
      background-color: var(--bg-code);
      padding: 16px;
      border-radius: 6px;
      overflow: auto;
      margin-bottom: 16px;
    }

    .markdown-body pre code {
      background-color: transparent;
      padding: 0;
    }

    .markdown-body blockquote {
      padding: 0 1em;
      color: var(--text-secondary);
      border-left: 0.25em solid var(--border-color);
      margin-bottom: 16px;
    }

    .markdown-body table {
      border-collapse: collapse;
      margin-bottom: 16px;
      width: 100%;
    }

    .markdown-body table th,
    .markdown-body table td {
      padding: 6px 13px;
      border: 1px solid var(--border-color);
    }

    .markdown-body table th {
      font-weight: 600;
      background-color: var(--bg-code);
    }

    .markdown-body table tr:nth-child(2n) {
      background-color: var(--bg-code);
    }

    .markdown-body a {
      color: var(--text-link);
      text-decoration: none;
    }

    .markdown-body a:hover {
      text-decoration: underline;
    }

    .markdown-body img {
      max-width: 100%;
      height: auto;
    }

    /* Mermaid diagram styling */
    .markdown-body .mermaid {
      background-color: var(--bg-primary);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      padding: 16px;
      margin-bottom: 16px;
    }

    .empty-state {
      text-align: center;
      padding: 64px 32px;
      color: var(--text-secondary);
    }

    .empty-state h2 {
      margin-bottom: 16px;
      color: var(--text-primary);
    }

    /* Bookmarks styling */
    .bookmarks-section {
      border-bottom: 1px solid var(--border-color);
    }

    .bookmarks-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .bookmarks-list li {
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
    }

    .bookmarks-list li:last-child {
      border-bottom: none;
    }

    .bookmark-btn {
      width: 100%;
      padding: 12px 16px;
      background: none;
      border: none;
      text-align: left;
      color: var(--text-link);
      font-size: 14px;
      cursor: pointer;
      transition: background-color 0.2s;
    }

    .shortcut-btn:hover, .bookmark-btn:hover {
      background-color: var(--bg-hover);
    }

    .bookmark-btn {
      text-overflow: ellipsis;
      overflow: hidden;
      white-space: nowrap;
    }

    .add-bookmark-btn {
      background: var(--text-link);
      color: #ffffff;
      border: none;
      border-radius: 4px;
      width: 24px;
      height: 24px;
      font-size: 18px;
      line-height: 1;
      cursor: pointer;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .add-bookmark-btn:hover {
      background-color: var(--text-link-hover);
    }

    .remove-bookmark-btn {
      background: var(--text-secondary);
      color: #ffffff;
      border: none;
      border-radius: 4px;
      width: 24px;
      height: 24px;
      font-size: 18px;
      line-height: 1;
      cursor: pointer;
      padding: 0;
      margin-left: 4px;
      margin-right: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .remove-bookmark-btn:hover {
      background-color: #d73a49;
    }

    .empty-bookmarks {
      padding: 12px 16px;
      color: var(--text-secondary);
      font-size: 13px;
      font-style: italic;
      border-bottom: none;
    }

    /* Syntax highlighting - Rouge GitHub theme for light mode */
    <%= Rouge::Themes::Github.render(scope: '.highlight') %>

    /* Syntax highlighting - Rouge dark theme for dark mode */
    <%= Rouge::Themes::Base16.mode(:dark).render(scope: '[data-theme="dark"] .highlight') %>

    /* Org-mode specific styles */
    .org-document-title {
      margin-bottom: 1.5em;
      padding-bottom: 0.5em;
      border-bottom: 1px solid var(--border-color);
    }

    .org-heading {
      margin-bottom: 1em;
    }

    .org-heading > h1,
    .org-heading > h2,
    .org-heading > h3,
    .org-heading > h4,
    .org-heading > h5,
    .org-heading > h6 {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5em;
    }

    .org-todo {
      font-size: 0.75em;
      padding: 2px 6px;
      border-radius: 3px;
      font-weight: bold;
      text-transform: uppercase;
      font-family: monospace;
    }

    .org-todo-todo {
      background-color: #ffcccc;
      color: #cc0000;
    }

    [data-theme="dark"] .org-todo-todo {
      background-color: #5c2020;
      color: #ff9999;
    }

    .org-todo-done {
      background-color: #ccffcc;
      color: #008800;
    }

    [data-theme="dark"] .org-todo-done {
      background-color: #205c20;
      color: #99ff99;
    }

    .org-tags {
      margin-left: auto;
      font-size: 0.8em;
    }

    .org-tag {
      background-color: var(--bg-code);
      padding: 2px 6px;
      border-radius: 3px;
      margin-left: 4px;
      font-family: monospace;
      color: var(--text-secondary);
    }

    .org-properties {
      margin: 0.5em 0 1em 0;
      padding: 0.5em;
      background-color: var(--bg-code);
      border-radius: 4px;
      font-size: 0.9em;
      border: 1px solid var(--border-color);
    }

    .org-properties summary {
      cursor: pointer;
      color: var(--text-secondary);
      font-weight: 500;
    }

    .org-properties dl {
      margin: 0.5em 0 0 1em;
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 0.25em 1em;
    }

    .org-properties dt {
      font-weight: bold;
      font-family: monospace;
      color: var(--text-secondary);
    }

    .org-properties dd {
      margin: 0;
      font-family: monospace;
    }

    .org-src-block {
      margin: 1em 0;
    }

    .org-src-block figcaption {
      font-size: 0.85em;
      color: var(--text-secondary);
      margin-bottom: 0.25em;
      font-style: italic;
    }

    .org-src-block pre {
      margin: 0;
    }

    .org-example-block {
      background-color: var(--bg-code);
      padding: 1em;
      border-radius: 4px;
      font-family: monospace;
      white-space: pre-wrap;
      border: 1px solid var(--border-color);
      margin: 1em 0;
    }

    .org-quote-block {
      border-left: 4px solid var(--border-highlight);
      padding-left: 1em;
      margin: 1em 0;
      color: var(--text-secondary);
      font-style: italic;
    }

    .org-table {
      border-collapse: collapse;
      margin: 1em 0;
      width: auto;
    }

    .org-table caption {
      font-size: 0.9em;
      color: var(--text-secondary);
      margin-bottom: 0.5em;
      text-align: left;
    }

    .org-table th,
    .org-table td {
      border: 1px solid var(--border-color);
      padding: 0.5em 1em;
      text-align: left;
    }

    .org-table th {
      background-color: var(--bg-secondary);
      font-weight: 600;
    }

    .org-table tr:hover td {
      background-color: var(--bg-hover);
    }

    .org-footnote-def {
      margin: 0.5em 0;
      font-size: 0.9em;
      padding-left: 2em;
      position: relative;
    }

    .org-footnote-label {
      font-weight: bold;
      position: absolute;
      left: 0;
    }

    .org-footnote-backref {
      margin-left: 0.5em;
      text-decoration: none;
      color: var(--text-link);
    }

    .org-footnote-backref:hover {
      color: var(--text-link-hover);
    }

    .org-raw {
      background-color: var(--bg-code);
      padding: 1em;
      border-radius: 4px;
      font-family: monospace;
      white-space: pre-wrap;
      border: 1px dashed var(--border-color);
      margin: 1em 0;
      color: var(--text-secondary);
    }

    /* Org list checkbox styling */
    .markdown-body li input[type="checkbox"] {
      margin-right: 0.5em;
    }
  </style>
</head>
<body>
  <div class="app-header">
    <div class="app-branding">
      <img src="/assets/marky-mark-icon2.png" alt="markymark" class="app-icon">
      <span class="app-name">markymark</span>
    </div>
    <div class="header-actions" data-current-file="<%= @current_file %>" data-current-dir="<%= @current_dir %>">
      <button class="action-btn" id="copy-path-btn" aria-label="Copy file path" title="Copy file path" <%= @current_file ? '' : 'disabled' %>>
        <span id="copy-icon">📋</span>
      </button>
      <button class="action-btn" id="edit-file-btn" aria-label="Edit file" title="Edit file" <%= @current_file ? '' : 'disabled' %>>
        <span id="edit-icon">✏️</span>
      </button>
      <button class="action-btn" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
        <span id="theme-icon">🌙</span>
      </button>
    </div>
  </div>

  <div class="main-container">
    <div class="sidebar">
    <div class="change-dir">
      <form action="/change-dir" method="post">
        <input type="text" name="path" placeholder="Enter directory path..." value="<%= self.class.root_path %>" id="dir-path">
        <div class="change-dir-buttons">
          <button type="button" class="browse-btn" onclick="window.location.href='/browse-dir?dir=<%= CGI.escape(@current_dir) %>'">Browse...</button>
          <button type="submit">Go</button>
        </div>
      </form>
    </div>

    <div class="bookmarks-section">
      <div class="sidebar-header" style="display: flex; justify-content: space-between; align-items: center;">
        <span>Bookmarks</span>
        <button type="button" class="add-bookmark-btn" onclick="addBookmark()" title="Add current directory">+</button>
      </div>
      <ul class="bookmarks-list">
        <% if @bookmarks && @bookmarks.any? %>
          <% @bookmarks.each_with_index do |bookmark, index| %>
            <li>
              <form action="/change-dir" method="post" style="margin: 0; flex: 1;">
                <input type="hidden" name="path" value="<%= bookmark['path'] %>">
                <button type="submit" class="bookmark-btn" title="<%= bookmark['path'] %>">
                  📌 <%= bookmark['name'] %>
                </button>
              </form>
              <form action="/bookmark/<%= index %>" method="post" style="margin: 0;" onsubmit="return confirm('Remove this bookmark?');">
                <input type="hidden" name="_method" value="delete">
                <button type="submit" class="remove-bookmark-btn" title="Remove bookmark">×</button>
              </form>
            </li>
          <% end %>
        <% else %>
          <li class="empty-bookmarks">No bookmarks yet</li>
        <% end %>
      </ul>
    </div>

    <div class="sidebar-header">
      <span>Files</span>
      <div class="accordion-controls">
        <button type="button" class="accordion-control-btn" onclick="expandAllDirectories()">Expand All</button>
        <button type="button" class="accordion-control-btn" onclick="collapseAllDirectories()">Collapse All</button>
      </div>
    </div>
    <div class="file-tree">
      <% @files_grouped.each do |dir, files| %>
        <% dir_id = "dir-" + dir.gsub(/[^a-zA-Z0-9]/, '-') %>
        <% is_expanded = dir == "." %>
        <div class="directory-section">
          <div class="directory-header" data-dir="<%= dir %>" onclick="toggleDirectory(this)">
            <span class="directory-arrow"><%= is_expanded ? '▼' : '►' %></span>
            <span class="directory-name"><%= dir == "." ? "📄 Root" : "📁 #{dir}" %></span>
            <span class="file-count">(<%= files.length %>)</span>
          </div>
          <ul class="directory-files" style="<%= is_expanded ? '' : 'display: none;' %>">
            <% files.each do |file| %>
              <% full_path = dir == "." ? file : File.join(dir, file) %>
              <li>
                <a href="/?file=<%= CGI.escape(full_path) %>&dir=<%= CGI.escape(@current_dir) %>" class="<%= full_path == @current_file ? 'active' : '' %>">
                  <%= file %>
                </a>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </div>

  <div class="content">
    <% if @html_content %>
      <div class="markdown-body">
        <%= @html_content %>
      </div>
    <% else %>
      <div class="empty-state">
        <h2>No Markdown Files Found</h2>
        <p>Add .md or .markdown files to the directory to get started.</p>
      </div>
    <% end %>
  </div>
  </div>

  <script>
    // Theme toggle functionality
    (function() {
      const html = document.documentElement;
      const themeToggle = document.getElementById('theme-toggle');
      const themeIcon = document.getElementById('theme-icon');

      // Get initial theme from localStorage or system preference
      function getInitialTheme() {
        const stored = localStorage.getItem('theme');
        if (stored) return stored;
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }

      // Apply theme
      function applyTheme(theme) {
        if (theme === 'dark') {
          html.setAttribute('data-theme', 'dark');
          themeIcon.textContent = '☀️';
        } else {
          html.removeAttribute('data-theme');
          themeIcon.textContent = '🌙';
        }
      }

      // Initialize theme
      const currentTheme = getInitialTheme();
      applyTheme(currentTheme);

      // Toggle theme on button click
      themeToggle.addEventListener('click', function() {
        const newTheme = html.hasAttribute('data-theme') ? 'light' : 'dark';
        localStorage.setItem('theme', newTheme);

        // Reload page to re-render mermaid diagrams with new theme
        window.location.reload();
      });
    })();

    // Helper to get current file info from URL params or data attributes
    function getCurrentFileInfo() {
      const params = new URLSearchParams(window.location.search);
      const headerActions = document.querySelector('.header-actions');

      // Try URL params first, fall back to data attributes
      const dir = params.get('dir') || (headerActions && headerActions.dataset.currentDir) || '';
      const file = params.get('file') || (headerActions && headerActions.dataset.currentFile) || '';

      return { dir, file };
    }

    // Copy file path functionality
    (function() {
      const copyBtn = document.getElementById('copy-path-btn');
      const copyIcon = document.getElementById('copy-icon');

      if (copyBtn) {
        copyBtn.addEventListener('click', async function() {
          if (copyBtn.disabled) return;

          const { dir, file } = getCurrentFileInfo();
          if (!file) return;

          const fullPath = dir ? (dir + '/' + file) : file;

          try {
            await navigator.clipboard.writeText(fullPath);
            // Show feedback
            const originalIcon = copyIcon.textContent;
            copyIcon.textContent = '✓';
            setTimeout(() => {
              copyIcon.textContent = originalIcon;
            }, 1500);
          } catch (err) {
            alert('Failed to copy path: ' + err.message);
          }
        });
      }
    })();

    // Edit file functionality
    (function() {
      const editBtn = document.getElementById('edit-file-btn');
      const editIcon = document.getElementById('edit-icon');

      if (editBtn) {
        editBtn.addEventListener('click', async function() {
          if (editBtn.disabled) return;

          const { dir, file } = getCurrentFileInfo();
          if (!file) return;

          try {
            const response = await fetch('/edit', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
              },
              body: new URLSearchParams({ dir: dir, file: file })
            });

            const result = await response.json();

            if (response.ok) {
              // Show brief success feedback
              const originalIcon = editIcon.textContent;
              editIcon.textContent = '✓';
              setTimeout(() => {
                editIcon.textContent = originalIcon;
              }, 1500);
            } else {
              alert('Failed to open editor: ' + (result.error || 'Unknown error'));
            }
          } catch (err) {
            alert('Failed to open editor: ' + err.message);
          }
        });
      }
    })();

    // Bookmark management
    function addBookmark() {
      const currentPath = document.getElementById('dir-path').value;
      const name = prompt('Enter a name for this bookmark:', currentPath.split('/').pop() || 'Home');

      if (name && name.trim()) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/bookmark';

        const nameInput = document.createElement('input');
        nameInput.type = 'hidden';
        nameInput.name = 'name';
        nameInput.value = name.trim();

        const pathInput = document.createElement('input');
        pathInput.type = 'hidden';
        pathInput.name = 'path';
        pathInput.value = currentPath;

        form.appendChild(nameInput);
        form.appendChild(pathInput);
        document.body.appendChild(form);
        form.submit();
      }
    }

    // Directory accordion functions
    function toggleDirectory(header) {
      const section = header.parentElement;
      const filesList = section.querySelector('.directory-files');
      const arrow = header.querySelector('.directory-arrow');
      const dir = header.getAttribute('data-dir');

      const isExpanded = filesList.style.display !== 'none';

      // Toggle visibility
      filesList.style.display = isExpanded ? 'none' : '';
      arrow.textContent = isExpanded ? '►' : '▼';

      // Save state to localStorage
      const key = 'markymark_dir_' + dir.replace(/[^a-zA-Z0-9]/g, '_');
      localStorage.setItem(key, isExpanded ? 'collapsed' : 'expanded');
    }

    function expandAllDirectories() {
      document.querySelectorAll('.directory-section').forEach(function(section) {
        const filesList = section.querySelector('.directory-files');
        const arrow = section.querySelector('.directory-arrow');
        const header = section.querySelector('.directory-header');
        const dir = header.getAttribute('data-dir');

        filesList.style.display = '';
        arrow.textContent = '▼';

        // Save state
        const key = 'markymark_dir_' + dir.replace(/[^a-zA-Z0-9]/g, '_');
        localStorage.setItem(key, 'expanded');
      });
    }

    function collapseAllDirectories() {
      document.querySelectorAll('.directory-section').forEach(function(section) {
        const filesList = section.querySelector('.directory-files');
        const arrow = section.querySelector('.directory-arrow');
        const header = section.querySelector('.directory-header');
        const dir = header.getAttribute('data-dir');

        filesList.style.display = 'none';
        arrow.textContent = '►';

        // Save state
        const key = 'markymark_dir_' + dir.replace(/[^a-zA-Z0-9]/g, '_');
        localStorage.setItem(key, 'collapsed');
      });
    }

    // Restore directory states from localStorage on page load
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.directory-section').forEach(function(section) {
        const header = section.querySelector('.directory-header');
        const filesList = section.querySelector('.directory-files');
        const arrow = section.querySelector('.directory-arrow');
        const dir = header.getAttribute('data-dir');

        const key = 'markymark_dir_' + dir.replace(/[^a-zA-Z0-9]/g, '_');
        const state = localStorage.getItem(key);

        if (state === 'collapsed') {
          filesList.style.display = 'none';
          arrow.textContent = '►';
        } else if (state === 'expanded') {
          filesList.style.display = '';
          arrow.textContent = '▼';
        }
        // If no state in localStorage, use default from template (root expanded, others collapsed)
      });
    });
  </script>
</body>
</html>
